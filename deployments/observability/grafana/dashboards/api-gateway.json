{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "targets": [{"expr": "sum(rate(http_server_requests_total[$__rate_interval]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "targets": [{"expr": "100 * sum(rate(http_server_errors_total[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_total[$__rate_interval])), 0.001)", "legendFormat": "5xx %", "refId": "A"}],
      "title": "Error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "http_server_requests_in_flight", "legendFormat": "in flight", "refId": "A"}],
      "title": "In-flight requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 6},
      "id": 4,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50 {{route}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{route}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{route}}", "refId": "C"}
      ],
      "title": "Request latency percentiles by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 6},
      "id": 5,
      "targets": [{"expr": "sum by (method, route) (rate(http_server_requests_total[$__rate_interval]))", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "title": "Request rate by route",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["go-commerce", "api-gateway"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "API Gateway",
  "uid": "api-gateway",
  "version": 1
}
